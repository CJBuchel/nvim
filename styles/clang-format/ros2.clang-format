# ROS 2 C++ style (ament_clang_format), used automatically for files inside a
# ROS 2 package that has no .clang-format of its own.
---
Language: Cpp
BasedOnStyle: Google

AccessModifierOffset: -2
AlignAfterOpenBracket: AlwaysBreak
BreakBeforeBraces: Custom
BraceWrapping:
  AfterClass: true
  AfterControlStatement: false
  AfterEnum: true
  AfterFunction: true
  AfterNamespace: true
  AfterObjCDeclaration: true
  AfterStruct: true
  AfterUnion: true
  BeforeCatch: true
  BeforeElse: false
  IndentBraces: false
ColumnLimit: 100
ConstructorInitializerIndentWidth: 0
ContinuationIndentWidth: 2
DerivePointerAlignment: false
PointerAlignment: Middle
ReflowComments: false
EmptyLineBeforeAccessModifier: Always
EmptyLineAfterAccessModifier: Never
BreakInheritanceList: BeforeColon
BreakConstructorInitializers: BeforeColon
IndentWidth: 2
TabWidth: 2
Cpp11BracedListStyle: true
AlignOperands: true
BreakBeforeTernaryOperators: false
SpaceAfterTemplateKeyword: true

# Editor-side addition: never reorder includes. Include order matters in some
# packages (e.g. the fmt workaround in platform_health) and it avoids noisy diffs.
SortIncludes: Never
